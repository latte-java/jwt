project(group: "org.lattejava", name: "jwt", version: "0.2.1", licenses: ["MIT"]) {
  workflow {
    standard()
  }

  publishWorkflow {
    latte()
  }

  dependencies {
    group(name: "compile") {
      // Ha! Just kidding. This is pure Java - no dependencies.
    }
    group(name: "test-compile", export: false) {
      dependency(id: "com.fasterxml.jackson.core:jackson-core:2.21.2")
      dependency(id: "com.fasterxml.jackson.core:jackson-databind:2.21.2")
      dependency(id: "org.bouncycastle:bc-fips:2.1.2")
      dependency(id: "org.testng:testng:7.12.0")
      // Gets rid of SLF warnings on test run
      //   SLF4J: Failed to load class "org.slf4j.impl.StaticLoggerBinder".
      //   SLF4J: Defaulting to no-operation (NOP) logger implementation
      //   SLF4J: See http://www.slf4j.org/codes.html#StaticLoggerBinder for further details.
      dependency(id: "org.slf4j:slf4j-nop:2.0.17")
    }
  }

  publications {
    standard()
  }
}

// Plugins
dependency = loadPlugin(id: "org.lattejava.plugin:dependency:0.6.0")
file = loadPlugin(id: "org.lattejava.plugin:file:0.6.0")
java = loadPlugin(id: "org.lattejava.plugin:java:0.6.0")
javaTestNG = loadPlugin(id: "org.lattejava.plugin:java-testng:0.6.0")
idea = loadPlugin(id: "org.lattejava.plugin:idea:0.6.1")
release = loadPlugin(id: "org.lattejava.plugin:release-git:0.6.0")

java.settings.javaVersion = "21"
javaTestNG.settings.javaVersion = "21"

target(name: "clean", description: "Cleans the build directory") {
  java.clean()
}

target(name: "build", description: "Compiles the Java source files and creates a JAR") {
  file.execute(cmd: "git config core.hooksPath .githooks")
  java.compileMain()
  java.settings.compilerArguments = "--add-modules jdk.httpserver"
  java.compileTest()
  java.jar()
}

target(name: "test", description: "Runs the project's tests", dependsOn: ["build"]) {
  boolean[] fipsEnabled = [false, true]
  if (switches.has("fips")) {
    fipsEnabled = [true]
  } else if (switches.has("jca")) {
    fipsEnabled = [false]
  }

  fipsEnabled.each { enabled ->
    javaTestNG.settings.jvmArguments = "-Dtest.fips=${enabled} --add-modules jdk.httpserver --add-reads org.lattejava.jwt=jdk.httpserver"
    javaTestNG.test()
  }
}

target(name: "doc", description: "Generate the project's JavaDoc", dependsOn: ["build"]) {
  java.document()
}

target(name: "int", description: "Releases a local integration build of the project", dependsOn: ["test"]) {
  dependency.integrate()
}

target(name: "release", description: "Releases a full version of the project", dependsOn: ["clean", "test"]) {
  release.release()
}

target(name: "idea", description: "Updates the IntelliJ IDEA module file") {
  idea.iml()
}

target(name: "format", description: "Formats the source code using IntelliJ's CLI") {
  file.execute(cmd: ["${SYS["user.home"]}/Applications/IntelliJ IDEA.app/Contents/bin/format.sh", "-r", "-s", ".idea/codeStyles/Project.xml", "src/main/java/"])
  file.execute(cmd: ["${SYS["user.home"]}/Applications/IntelliJ IDEA.app/Contents/bin/format.sh", "-r", "-s", ".idea/codeStyles/Project.xml", "src/test/java/"])
}

target(name: "print-dependency-tree", description: "Prints the dependency tree") {
  dependency.printFull()
}
